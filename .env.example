# Example process environment values for local development.
# The dependency-free M1 build reads os.environ directly and does NOT auto-load .env.
# In PowerShell, set overrides with commands such as:
#   $env:POLL_INTERVAL_SECONDS = "60"
# Never commit real secrets.
APP_ENV=development
APP_TIMEZONE=Asia/Hong_Kong
DATABASE_PATH=data/quota_alert.sqlite3

# GovHK / Immigration Department public quota preview source (service id 579).
# Keep one shared poller for all users; do not increase source traffic per subscriber.
QUOTA_SOURCE_SERVICE_ID=579
QUOTA_SOURCE_TIMEOUT_SECONDS=20

# Shared poller cadence. Positive jitter only slows requests. Transport, parse and
# structural failures back off exponentially; complete stale snapshots do not.
POLL_INTERVAL_SECONDS=60
POLL_JITTER_SECONDS=5
POLL_MAX_BACKOFF_SECONDS=900

# An active quota must be absent from this many consecutive valid snapshots before
# the occurrence is considered closed. Fetch/parse failures never count as absence.
MISSING_CONFIRMATIONS_REQUIRED=2

# Tencent Cloud SES SendEmail API. Use a least-privilege CAM identity and never
# commit real credentials. All four approved transactional template IDs are required
# before starting the email worker.
TENCENTCLOUD_SECRET_ID=
TENCENTCLOUD_SECRET_KEY=
TENCENT_SES_REGION=ap-hongkong
TENCENT_SES_FROM_NAME=Appointment Notice
TENCENT_SES_FROM_EMAIL=
TENCENT_SES_REPLY_TO=
TENCENT_SES_VERIFY_EMAIL_TEMPLATE_ID=
TENCENT_SES_ACTIVATION_TEST_TEMPLATE_ID=
TENCENT_SES_QUOTA_ALERT_TEMPLATE_ID=
TENCENT_SES_MANAGE_LINK_TEMPLATE_ID=

# At least 32 random characters. Used to derive verification and management URL
# signatures; tokens themselves are never stored in plaintext.
TOKEN_SIGNING_SECRET=replace-with-at-least-32-random-characters
PUBLIC_BASE_URL=http://127.0.0.1:8080
