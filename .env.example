# Copy this file to .env for local development. Never commit real secrets.
APP_ENV=development
APP_TIMEZONE=Asia/Hong_Kong
DATABASE_PATH=data/quota_alert.sqlite3

# GovHK / Immigration Department public quota preview source (service id 579).
# Keep one shared poller for all users; do not increase source traffic per subscriber.
QUOTA_SOURCE_SERVICE_ID=579
QUOTA_SOURCE_TIMEOUT_SECONDS=20

# Shared poller cadence. Positive jitter only slows requests; repeated failures back off
# exponentially up to the configured maximum.
POLL_INTERVAL_SECONDS=60
POLL_JITTER_SECONDS=5
POLL_MAX_BACKOFF_SECONDS=900

# An active quota must be absent from this many consecutive valid snapshots before
# the occurrence is considered closed. Fetch/parse failures never count as absence.
MISSING_CONFIRMATIONS_REQUIRED=2

# Configure only when the notification module is implemented.
SMTP_HOST=
SMTP_PORT=465
SMTP_USERNAME=
SMTP_APP_PASSWORD=
SMTP_FROM_NAME=ID Quota Alert
SMTP_FROM_EMAIL=
