[Unit]
Description=HKID Alert email outbox worker
After=network-online.target hkid-poller.service
Wants=network-online.target

[Service]
Type=simple
User=hkid-alert
Group=hkid-alert
WorkingDirectory=/opt/hkid-quota-alert
EnvironmentFile=/etc/hkid-quota-alert.env
ExecStart=/opt/hkid-quota-alert/.venv/bin/python -m app email-worker
Restart=on-failure
RestartSec=10
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
